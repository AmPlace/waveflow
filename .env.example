# Hit FM 官网 Ajax 请求所需 Cookie。
# 示例格式：HITFM_COOKIE=PHPSESSID=你的会话值
HITFM_COOKIE=

# Docker Compose 正式部署必填。使用同一个不可变提交标签，例如 sha-<git-commit>。
# backend 与 frontend 必须使用同一 release identity。
WAVEFLOW_RELEASE_VERSION=

# 部署模式：desktop / nas / public。NAS 默认允许匿名浏览和播放，public 默认收紧。
WAVEFLOW_MODE=nas
# 显式覆盖模式默认值（可选）。
# WAVEFLOW_ANONYMOUS_BROWSE=true
# WAVEFLOW_ANONYMOUS_PLAYBACK=true
# WAVEFLOW_ALLOW_PRIVATE=true
# WAVEFLOW_ALLOW_LOOPBACK=false
# WAVEFLOW_ENABLE_RTSP_PROXY=true
# WAVEFLOW_PUBLIC_BASE_URL=https://example.com
# WAVEFLOW_TRUSTED_PROXIES=
# WAVEFLOW_RTSP_MAX_SESSIONS=8
# WAVEFLOW_M3U8_CACHE_TTL=60
# WAVEFLOW_M3U8_CACHE_MAX_ENTRIES=1000
# WAVEFLOW_MEDIA_CREDENTIAL_DEFAULT_TTL_DAYS=90
# WAVEFLOW_SESSION_MAX_AGE_DAYS=14
# WAVEFLOW_PROBE_CONCURRENCY=8
# WAVEFLOW_SUBSCRIPTION_REFRESH_COOLDOWN=60
# WAVEFLOW_ALLOWED_ORIGINS=
# WAVEFLOW_DOCS_ENABLED=
# WAVEFLOW_PROXY_HANDLE_SECRET=
# WAVEFLOW_SESSION_SECRET=
# WAVEFLOW_DESKTOP_SESSION=
