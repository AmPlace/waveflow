    {
      "contract": "tv_provider",
      "contract_version": "1.0",
      "features": [
        "resolve_stream"
      ]
    }
  ],
  "owned_schemes": [
    {
      "scheme": "hnntv",
      "contract": "tv_provider"
    }
  ],
  "capabilities": [
