{
  "name": "waveflow-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build:frontend": "cd frontend && npm install && npm run build -- --mode desktop",
    "build:electron": "electron-vite build",
    "electron:start": "electron .",
    "electron:start:debug": "electron . --waveflow-debug",
    "electron:build:win": "npm run desktop:win",
    "electron:build:mac": "npm run desktop:mac",
    "desktop:win": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop-win.ps1",
    "desktop:mac": "bash scripts/build-desktop-mac.sh"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.waveflow.desktop",
    "productName": "WaveFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend_dist",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "dir",
        "zip",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
